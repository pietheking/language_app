# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
HOST=127.0.0.1
PORT=3000
# Set to your exact HTTPS origin when deploying behind a reverse proxy.
APP_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_LIMIT=200

# Example: postgresql://translator:password@localhost:5432/language_app
# Hosted databases: use sslmode=verify-full for verified TLS.
DATABASE_URL=
